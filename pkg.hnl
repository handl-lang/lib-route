-- lib-route: modules this package provides (entry defaults to
-- src/index.hnl; N modules resolve to src/<name>/index.hnl).
{ modules: ["route"], name: "route", description: "Transport-agnostic routing + middleware-pipeline library in pure handl: v3 pattern compiler (literals, :params, *splats, (/optional) groups, :suffix.vars, ?k=v constraints), segment-trie compile/match/dispatch with specificity ranking, and the {out,state} onion pipeline (pipeline/chain/end/state_get/state_put).", license: "MIT", keywords: ["routing", "middleware", "pipeline", "trie", "stdlib", "handl"], homepage: "https://github.com/handl-lang/lib-route" }
