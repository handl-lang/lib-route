--- test_fixtures -- shared fixtures/helpers for `index.test.hnl`.
---
--- `hnl test` evaluates each case as `do { <every non-test top-level
--- statement>; <test body> }`, so anything left in the test file's
--- top-level is re-evaluated once per test case. The route compiles
--- below cost seconds each under the tree-walk interpreter; living in
--- an imported module they are evaluated once per worker (the runtime
--- caches module bindings by path) instead of 59 times.

from "./index" import * as rt
from "str" import * as str

export alen2 := (xs) ~> while { xs: xs, n: 0 } {
  (xs, n) ~> match xs {
    []: { out: n },
    [_h, ...t]: { state: { xs: t, n: n + 1 } }
  }
}

export tokens_of := (p) ~> str.split(p, "/")

export first_cand := (cs) ~> match cs {
  [c, ..._t]: c,
  []: null
}

export cp_cons := rt.compile_pat("/a?x=1&flag&y=a%20b")

export entries1 := [
  { path: "/health" },
  { path: "/users/:id", tag: "user" },
  { path: "/files/*rest" }
]

export trie1 := rt.compile(entries1)

export cons_trie := rt.compile([
  { pattern: "/search?q=handl", tag: "t" },
  { path: "/other", constraints: [{ k: "page", v: "1" }] }
])

export spec_trie := rt.compile([
  { path: "/a/:x" },      -- i=0 param
  { path: "/a/b" },       -- i=1 literal
  { path: "/a/b/*r" },    -- i=2 splat
  { path: "/a/:y" }       -- i=3 param, ties with i=0
])

export mw_tag := (ctx, next) ~> do {
  r := next(rt.state_put(ctx, "tag", "mw"))
  { out: r.out, state: r.state }
}

export mw_short := (_ctx, _next) ~> do {
  { out: { status: 401, body: "denied" }, state: {} }
}

export boom := (_ctx) ~> error.raise("must not run")

export mw_a := (ctx, next) ~> do {
  s0 := rt.state_get(ctx, "seq")
  s := if s0 == null { "" } else { s0 }
  r := next(rt.state_put(ctx, "seq", s + "A"))
  { out: r.out, state: r.state }
}

export mw_b := (ctx, next) ~> do {
  s0 := rt.state_get(ctx, "seq")
  s := if s0 == null { "" } else { s0 }
  r := next(rt.state_put(ctx, "seq", s + "B"))
  { out: r.out, state: r.state }
}

export seq_term := (ctx) ~> do {
  { out: rt.state_get(ctx, "seq"), state: {} }
}

export state_term := (ctx) ~> do {
  { out: rt.state_get(ctx, "who"), state: { seen: true } }
}

export mw_who := (ctx, next) ~> do {
  r := next(rt.state_put(ctx, "who", "inner"))
  { out: r.out, state: r.state }
}

export ctx0 := { req: {}, state: {} }
export ctx1 := rt.state_put(ctx0, "k", "v")

export rm_h := (r) ~> r

--- first entry whose derived/explicit `name` is `n`, or null.
export rm_find := (ents, n) ~> while { xs: ents, out: null } {
  (xs, out) ~> match xs {
    []: { out: out },
    [e, ...t]: if hash_map.get_or(e, "name", null) == n {
      { out: e }
    } else {
      { state: { xs: t, out: out } }
    }
  }
}

export rm_map := rt.route_map({
  ".": rm_h,
  health: rm_h,
  users: { ":id": rm_h },
  api: { v1: { get: rm_h, post: rm_h, path: "/v1" } },
  s: { method: "put", path: "explicit", handler: rm_h,
       constraints: { q: "yes" }, doc: { summary: "x" }, name: "op" }
}, { methods: ["GET", "POST", "PUT", "PATCH", "DELETE", "HEAD",
  "OPTIONS"] })

-- custom leaf_keys: the payload field is copied, other fields are not.
export rm_cb := rt.route_map({ cb: { run: rm_h, tag: "x" } },
  { leaf_keys: ["run"] })

-- sep override joins key segments with the transport separator.
export rm_sep := rt.route_map({ a: { b: rm_h } }, { sep: ":" })

-- them through verbatim onto each entry.
export rm_mspec := rt.route_map({ a: { get: rm_h, doc: { t: 1 } } },
  { methods: ["GET"], spec_keys: ["doc"] })

export rm_trie := rt.compile(rm_map)
